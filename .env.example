# One LLM key is enough. Without any, AnyVoice falls back to regex heuristics for casting.
# ANTHROPIC_API_KEY=sk-ant-...          # default model: claude-opus-5
# OPENROUTER_API_KEY=sk-or-...          # + LLM_PROVIDER=openrouter   default model: moonshotai/kimi-k3
# OPENAI_API_KEY=sk-...                 # + LLM_PROVIDER=openai       default model: gpt-5.4-mini
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5

# Expressive-dialogue worker (engines/chatterbox/run.sh). Leave the default unless you run it elsewhere.
# CHATTERBOX_URL=http://127.0.0.1:8091
